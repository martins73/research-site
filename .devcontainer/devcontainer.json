{
  "name": "research-site",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "site",
  "workspaceFolder": "/site",
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Site", "onAutoForward": "openBrowser" },
    "35729": { "label": "Live reload", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["redhat.vscode-yaml", "sissel.shopify-liquid"]
    }
  }
}
